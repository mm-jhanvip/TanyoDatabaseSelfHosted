<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.2.0" />
  <PropertyGroup>
    <Name>TanyoLogsDB</Name>
    <ProjectGuid>{36FC47BB-250D-4AA7-B1C0-E6B78E587C71}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <SuppressTSqlWarnings>71501,71562</SuppressTSqlWarnings>
  </PropertyGroup>
  <ItemGroup>
    <None Include=".vscode\tasks.json" />
    <!-- Instance-level logins and their users are managed by the deployment environment. -->
    <Build Remove="Security\**\*.sql" />
  </ItemGroup>
  <Target Name="BeforeBuild">
    <Delete Files="$(BaseIntermediateOutputPath)\project.assets.json" />
  </Target>
</Project>